{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamsonLab/cinelark/specs/remote/envelope.schema.json",
  "title": "CineLark Remote Protocol Envelope",
  "description": "Draft version 1 envelope transported over an authenticated TLS session.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocolVersion",
    "id",
    "type",
    "sentAt",
    "sequence",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "replyTo": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  }
}
