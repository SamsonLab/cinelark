{
  "info": {
    "_postman_id": "8fead59f-45d2-45df-bf09-e91f9f2fa176",
    "name": "CineLark Emby v1 Contract",
    "description": "Validates the Emby API surface consumed by CineLark. Run 00 Bootstrap before authenticated folders. Mutation and playback folders change remote user state.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Emby-Authorization", "type": "string" },
      { "key": "value", "value": "{{emby_authorization}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function quote(value) {",
          "  return String(value || '').replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\\\"');",
          "}",
          "const token = pm.environment.get('access_token') || '';",
          "let authorization = `MediaBrowser Client=\"${quote(pm.environment.get('client_name'))}\", Device=\"${quote(pm.environment.get('device_name'))}\", DeviceId=\"${quote(pm.environment.get('device_id'))}\", Version=\"${quote(pm.environment.get('client_version'))}\"`;",
          "if (token) authorization += `, Token=\"${quote(token)}\"`;",
          "pm.variables.set('emby_authorization', authorization);",
          "const baseURL = String(pm.environment.get('base_url') || '').replace(/\\/$/, '');",
          "pm.variables.set('mock_control_url', baseURL.replace(/\\/emby$/i, ''));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP request succeeded', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "pm.test('Access token is not present in the URL', function () {",
          "  const token = pm.environment.get('access_token');",
          "  if (token) pm.expect(pm.request.url.toString()).not.to.include(token);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Bootstrap",
      "description": "Validate the server and authenticate. These requests populate all downstream identity variables.",
      "item": [
        {
          "name": "Public System Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/System/Info/Public",
            "description": "CineLark uses this endpoint to validate the base URL and obtain stable server identity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Public system info contains stable identity', function () {",
                  "  pm.expect(body.Id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.ServerName).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('server_id', body.Id);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Local Mock Example",
              "originalRequest": { "method": "GET", "header": [], "url": "{{base_url}}/System/Info/Public" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"Id\": \"cinelark-mock-server\",\n  \"ServerName\": \"CineLark Local Mock\",\n  \"Version\": \"4.9.0.0\"\n}"
            }
          ]
        },
        {
          "name": "Authenticate User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Username\": \"{{username}}\",\n  \"Pw\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/Users/AuthenticateByName",
            "description": "Stores AccessToken and User.Id in the selected environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Authentication returns user and token', function () {",
                  "  pm.expect(body.AccessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.User.Id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('access_token', body.AccessToken);",
                  "pm.environment.set('user_id', body.User.Id);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Local Mock Example",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"Username\":\"mock\",\"Pw\":\"mock\"}" },
                "url": "{{base_url}}/Users/AuthenticateByName"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"AccessToken\": \"mock-access-token\",\n  \"ServerId\": \"cinelark-mock-server\",\n  \"User\": { \"Id\": \"user-1\", \"Name\": \"Mock User\" }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "01 Library",
      "item": [
        {
          "name": "User Views",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Views",
            "description": "Maps Emby library views to CineLark MediaCollection values."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Views use an Emby item page', function () {",
                  "  pm.expect(body.Items).to.be.an('array');",
                  "  pm.expect(body.TotalRecordCount).to.be.a('number');",
                  "});",
                  "if (body.Items.length) pm.environment.set('collection_id', body.Items[0].Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Browse Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items?Recursive=true&StartIndex=0&Limit=60&Fields=Overview,ProviderIds,UserData,RunTimeTicks&IncludeItemTypes=Movie",
            "description": "Equivalent to CineLark's first-page movie MediaQuery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Browse response is pageable', function () {",
                  "  pm.expect(body.Items).to.be.an('array');",
                  "  pm.expect(body.TotalRecordCount).to.be.a('number');",
                  "});",
                  "const movie = body.Items.find(item => item.Type === 'Movie');",
                  "if (movie) pm.environment.set('item_id', movie.Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Browse Series",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items?Recursive=true&StartIndex=0&Limit=60&Fields=Overview,ProviderIds,UserData,RunTimeTicks&IncludeItemTypes=Series",
            "description": "Equivalent to CineLark's first-page series MediaQuery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const series = body.Items.find(item => item.Type === 'Series');",
                  "pm.test('Series response contains mapped items', function () { pm.expect(series).to.exist; });",
                  "if (series) pm.environment.set('series_id', series.Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items?Recursive=true&StartIndex=0&Limit=60&Fields=Overview,ProviderIds,UserData,RunTimeTicks&SearchTerm={{search_term}}",
            "description": "Latest-wins behavior is implemented by TCA; this request validates the provider response shape."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Search returns an item page', function () { pm.expect(body.Items).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items/Latest?Limit=30&Fields=Overview,ProviderIds,UserData,RunTimeTicks,People",
            "description": "Latest returns an array rather than an ItemPage wrapper."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Latest returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Resume",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items/Resume?Recursive=true&StartIndex=0&Limit=30&Fields=Overview,ProviderIds,UserData,RunTimeTicks",
            "description": "Remote resume state is import-only; local Profile state remains authoritative in CineLark."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Resume exposes user playback ticks', function () {",
                  "  pm.expect(body.Items).to.be.an('array');",
                  "  if (body.Items.length) pm.expect(body.Items[0].UserData.PlaybackPositionTicks).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Favorites Import Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items?Recursive=true&StartIndex=0&Limit=200&Fields=Overview,ProviderIds,UserData,RunTimeTicks&IncludeItemTypes=Movie,Series&IsFavorite=true",
            "description": "One page of the explicit remote-state import flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Favorite filter is reflected in UserData', function () {",
                  "  body.Items.forEach(item => pm.expect(item.UserData.IsFavorite).to.eql(true));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Metadata & Hierarchy",
      "item": [
        {
          "name": "Movie Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items/{{item_id}}",
            "description": "Full item detail including People and ProviderIds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Detail has CineLark metadata inputs', function () {",
                  "  pm.expect(body.Id).to.be.a('string');",
                  "  pm.expect(body.Name).to.be.a('string');",
                  "  pm.expect(body.ProviderIds).to.be.an('object');",
                  "  pm.expect(body.People).to.be.an('array');",
                  "});",
                  "const person = (body.People || []).find(value => value.Id);",
                  "if (person) pm.environment.set('person_id', person.Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Seasons",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Shows/{{series_id}}/Seasons?UserId={{user_id}}&Fields=UserData"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Season page is valid', function () { pm.expect(body.Items).to.be.an('array'); });",
                  "if (body.Items.length) pm.environment.set('season_id', body.Items[0].Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Episodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Shows/{{series_id}}/Episodes?UserId={{user_id}}&SeasonId={{season_id}}&StartIndex=0&Limit=20&Fields=Overview,UserData,RunTimeTicks,MediaSourceCount"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Episode page contains hierarchy identity', function () {",
                  "  pm.expect(body.Items).to.be.an('array');",
                  "  if (body.Items.length) pm.expect(body.Items[0].SeasonId).to.eql(pm.environment.get('season_id'));",
                  "});",
                  "if (body.Items.length) pm.environment.set('episode_id', body.Items[0].Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Person Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items/{{person_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Person detail has identity', function () {",
                  "  pm.expect(body.Id).to.be.a('string');",
                  "  pm.expect(body.Name).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Person Works",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Users/{{user_id}}/Items?Recursive=true&StartIndex=0&Limit=60&Fields=Overview,ProviderIds,UserData,RunTimeTicks&PersonIds={{person_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Person works returns an item page', function () { pm.expect(pm.response.json().Items).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Playback Lifecycle",
      "description": "These requests report playback activity to the selected Emby user.",
      "item": [
        {
          "name": "Playback Info",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"DeviceProfile\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/Items/{{item_id}}/PlaybackInfo",
            "description": "CineLark selects the first direct-play or direct-stream media source and does not request transcoding in v1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const source = body.MediaSources.find(value => value.SupportsDirectPlay || value.SupportsDirectStream);",
                  "pm.test('A direct-playable media source exists', function () { pm.expect(source).to.exist; });",
                  "if (source) pm.environment.set('media_source_id', source.Id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Started",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ItemId\": \"{{item_id}}\",\n  \"PositionTicks\": 0,\n  \"IsPaused\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/Sessions/Playing"
          }
        },
        {
          "name": "Progress",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ItemId\": \"{{item_id}}\",\n  \"PositionTicks\": {{position_ticks}},\n  \"IsPaused\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/Sessions/Playing/Progress"
          }
        },
        {
          "name": "Stopped",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ItemId\": \"{{item_id}}\",\n  \"PositionTicks\": {{position_ticks}},\n  \"IsPaused\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/Sessions/Playing/Stopped"
          }
        }
      ]
    },
    {
      "name": "04 User State Mutations",
      "description": "Run against a dedicated test account. These requests change favorites and played state.",
      "item": [
        {
          "name": "Add Favorite",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/Users/{{user_id}}/FavoriteItems/{{item_id}}" }
        },
        {
          "name": "Remove Favorite",
          "request": { "method": "DELETE", "header": [], "url": "{{base_url}}/Users/{{user_id}}/FavoriteItems/{{item_id}}" }
        },
        {
          "name": "Mark Played",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/Users/{{user_id}}/PlayedItems/{{item_id}}" }
        },
        {
          "name": "Mark Unplayed",
          "request": { "method": "DELETE", "header": [], "url": "{{base_url}}/Users/{{user_id}}/PlayedItems/{{item_id}}" }
        }
      ]
    },
    {
      "name": "05 Artwork",
      "item": [
        {
          "name": "Primary Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Items/{{item_id}}/Images/Primary",
            "description": "Authorization stays in X-Emby-Authorization and is never appended to the artwork URL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Primary artwork is an image', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('image/'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Backdrop Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/Items/{{item_id}}/Images/Backdrop/0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Backdrop artwork is an image', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('image/'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "99 Local Mock Control",
      "description": "Local fixture-only endpoints. Do not run this folder against a real Emby server.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Read Mock State",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{mock_control_url}}/__mock__/state" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Mock state is inspectable', function () {",
                  "  pm.expect(body.favorite_item_ids).to.be.an('array');",
                  "  pm.expect(body.playback_events).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Mock State",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [], "url": "{{mock_control_url}}/__mock__/reset" }
        }
      ]
    }
  ],
  "variable": [
    { "key": "emby_authorization", "value": "" },
    { "key": "mock_control_url", "value": "" }
  ]
}
